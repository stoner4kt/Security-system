# ---- Supabase ---------------------------------------------------------
# Create a project at https://supabase.com/dashboard → Settings → API
# Anon key is safe for browsers (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key. SERVER-SIDE ONLY. Never leaks into the client bundle —
# access it exclusively inside Supabase Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Cloudinary --------------------------------------------------------
# Dashboard → Settings → Access Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
# Only needed if you sign uploads server-side (recommended for production).
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Resend -------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
# Verified "from" sender, e.g. no-reply@yourdomain.com
RESEND_FROM_EMAIL=no-reply@securefleet.example.com
# Recipient of daily shift summaries / incident alerts
ADMIN_ALERT_EMAIL=ops@securefleet.example.com

# ---- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.pages.dev

# Optional: credentials for the one-click "Demo sign-in" button on /login.
# Create this user in Supabase Auth and promote it to admin first
# (see docs/DEPLOYMENT.md §1.4).
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=demo.admin@securefleet.example.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=ChangeMe-2026-demo

# Shared secret used to authenticate database webhooks calling edge functions
# (sent as header `x-sentinel-secret`). Generate with `openssl rand -hex 24`.
WEBHOOK_SECRET=generate-a-random-value-here